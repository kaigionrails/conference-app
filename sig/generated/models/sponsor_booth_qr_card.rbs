  LOGO_SIZE: Integer

  LOGO_TOP: Integer

  # The same size as the logo. 689px is 53 modules (version 7 with the quiet zone) of 13px each.
  QR_MAX_SIZE: Integer

  QR_TOP: Integer

  # Nothing is drawn over the QR code, so level M is enough and keeps the modules large.
  QR_LEVEL: Symbol

  QR_QUIET_ZONE: Integer

  A5_WIDTH_MM: Float

  LOGO_FETCH_TIMEOUTS: Hash[Symbol, Integer]

  @stamp_url: String

  @logo: String

  @template: String

