  # Runs once, after a provider has created a brand new user. Subclasses that
  # override this must call super.
  #
  # @rbs user: User
  # @rbs return: void
  def self.after_create_user: (User user) -> void

  # @rbs auth: untyped
  # @rbs return: String?
  def self.preferred_handle: (untyped auth) -> String?

  # @rbs auth: untyped
  # @rbs return: String
