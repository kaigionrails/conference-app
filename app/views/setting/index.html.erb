<% content_for(:page_title, t(".title")) %>
<div class="w-full max-w-(--breakpoint-xl) mx-auto pt-4 px-4 pb-6">
  <h2 class="font-bold text-3xl mb-4"><%= t('.title') %></h2>
  <h3 class="font-bold text-2xl mb-2"><%= t('.push_notification_setting') %></h3>
  <p class="mb-2"><%= t('.push_notification_description') %></p>
  <ul class="list-disc pl-6 leading-loose mb-2">
    <li><%= t('.push_notification_timing_bookmarked_talks') %></li>
    <li><%= t('.push_notification_timing_announcements_by_orgs') %></li>
  </ul>
  <p class="mb-2"><%= t('.ios_device_note') %></p>
  <p class="mb-4"><%= t('.reference') %>: <%= link_to t('.ios_pwa_support_page_title'), t('.ios_pwa_support_page_url'), target: "_blank", class: "underline" %></p>
  <% if logged_in? %>
    <div data-controller="push-notification">
      <button data-action="click->push-notification#toggleSubscriptionStatus" data-push-notification-target="status" class="rounded-md bg-white px-3 py-3 mr-3 font-semibold text-gray-900 shadow-xs ring-1 ring-inset ring-gray-400 hover:bg-gray-50 disabled:bg-gray-400 disabled:pointer-events-none disabled:shadow-none mb-4"><%= t('.enable_push_notification') %></button>
      <button data-action="click->push-notification#sendSamplePushNotification" data-push-notification-target="sendSample" class="rounded-md bg-white px-3 py-3 mb-4 font-semibold text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 hover:bg-gray-50 disabled:bg-slate-500 disabled:pointer-events-none disabled:shadow-none disabled:ring-0">
        <%= t('.send_test_push_notification') %>
      </button>
      <p class="mb-1"><%= t('.test_push_notification_will_send_all_devices') %></p>
      <p><%= t('.push_notification_disclaimer') %></p>
    </div>
  <% else %>
    <p class="mb-3"><%= t('.need_login') %></p>
    <%= render "shared/login_providers", variant: :card %>
  <% end %>
</div>
