<div class="stamp-rally-railway" role="progressbar" aria-label="<%= t("sponsor_stamp_cards.show.progress") %>" aria-valuenow="<%= progress.visited_count %>" aria-valuemin="0" aria-valuemax="<%= progress.total_count %>">
  <div class="stamp-rally-progress-track">
    <div class="stamp-rally-progress-fill" style="width: <%= progress.percentage %>%"></div>
  </div>
  <div class="stamp-rally-goal-station" aria-hidden="true">
    <%= image_tag "station-goal.png", alt: "", width: 1402, height: 1122 %>
  </div>
  <div class="stamp-rally-train-route" aria-hidden="true">
    <%= image_tag "rails-train.gif", class: "stamp-rally-train", style: "left: #{progress.percentage}%", alt: "", width: 72, height: 72 %>
  </div>
</div>
