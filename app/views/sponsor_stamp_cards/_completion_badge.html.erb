<%= tag.div class: class_names("stamp-rally-completion-badge", "stamp-rally-completion-badge--#{size}"),
      data: {completion_badge: true, completion_year: completion.event.slug} do %>
  <div class="stamp-rally-completion-emblem">
    <svg class="stamp-rally-completion-crown" viewBox="0 0 40 24" aria-hidden="true" focusable="false">
      <path d="M3 5 12 11 20 2 28 11 37 5 33 21H7Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round" stroke-width="2" />
    </svg>
    <%= image_tag completion_badge_icon_path(completion), alt: "", width: 112, height: 112 %>
  </div>
  <div class="stamp-rally-completion-caption">
    <p class="font-bold"><%= completion.event.slug %> · ALL COMPLETE</p>
    <p class="sr-only"><%= t("sponsor_stamp_cards.completion_badge.description") %></p>
  </div>
<% end %>
