<h2 h2 class="font-bold text-xl mb-8">Live</h2>

<div class="pr-8">
  <div class="mb-8">
  <%= link_to "Create new live stream", new_admin_live_stream_path, class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
  </div>
  <div class="mb-8">
    <h3 class="font-bold text-lg">YOYO Translate (<%= @yoyo_translate_setting.event.name %>)</h3>
    <%= form_with model: @yoyo_translate_setting, url: admin_yoyo_translate_setting_path, method: :patch do |f| %>
      <% if @yoyo_translate_setting.errors.any? %>
        <p class="mb-2 text-sm text-red-700"><%= @yoyo_translate_setting.errors.full_messages.join(", ") %></p>
      <% end %>
      <%= f.label :magenta_hall_url, "Magenta Hall URL", class: "block text-lg font-bold mb-2" %>
      <%= f.url_field :magenta_hall_url, placeholder: "https://", class: "block rounded-sm border-1 border-gray-400 mb-4 w-[40rem]" %>
      <%= f.label :lime_hall_url, "Lime Hall URL", class: "block text-lg font-bold mb-2" %>
      <%= f.url_field :lime_hall_url, placeholder: "https://", class: "block rounded-sm border-1 border-gray-400 mb-4 w-[40rem]" %>
      <%= f.submit "Save", class: "block border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
    <% end %>
  </div>
  <div class="mb-8">
    <h3 class="font-bold text-lg">live streams</h3>
    <% @cloudflare_stream_live_streams.each do |live_stream| %>
      <div class="mb-4">
        <h4 class="font-bold text-lg mb-2"><%= "#{live_stream.name} (id:#{live_stream.id})" %></h4>
      <%= link_to "show", admin_live_stream_path(live_stream), class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
