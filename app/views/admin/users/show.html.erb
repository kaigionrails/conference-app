<h2 class="font-bold text-xl mb-8">User <%= @user.name %> (id:<%= @user.id %>)</h2>
<div class="mb-8">
  <h3 class="font-bold text-lg mb-2">Id</h3>
  <p class="mb-4"><%= @user.id %></p>
  <h3 class="font-bold text-lg mb-2">Name</h3>
  <p class="mb-4"><%= @user.name %></p>
  <h3  class="font-bold text-lg mb-2">Role</h3>
  <p class="mb-4"><%= @user.role %></p>
  <%= link_to "edit", edit_admin_user_path(@user), class: "underline" %>
  <h3 class="font-bold text-lg mb-2">Profile</h3>
  <h4 class="font-bold text-lg mb-2">Display name</h4>
  <p class="mb-4"><%= @user.profile.name %></p>
  <h4 class="font-bold text-lg mb-2">Description</h4>
  <p class="mb-4"><%= @user.profile.description %></p>
  <h4 class="font-bold text-lg mb-2">Images</h4>
  <div class="flex flex-row flex-wrap mb-4">
    <% @user.profile.images.each do |profile_image| %>
      <%= image_tag profile_image, class: "w-28 h-28 object-cover rounded-lg mr-4"%>
    <% end %>
  </div>
  <div class="mb-4">
    <%= link_to "edit", edit_admin_user_path(@user), class: "underline" %>
  </div>
  <div>
    <%= link_to "edit profile badges", new_admin_profile_profile_badges_profile_path(profile_id: @user.profile.id), class: "underline" %>
  </div>
</div>
<% if @user.organizer? %>
  <div class="mb-8">
    <h3 class="font-bold text-lg mb-2">Sponsor stamps</h3>
    <p class="mb-4">Reset all stamps for the selected event.</p>
    <%= form_with url: admin_user_sponsor_visits_path(@user), method: :delete, data: { turbo_confirm: "Are you sure you want to reset? This cannot be undone." } do |form| %>
      <%= form.label :event_id, "Event" %>
      <%= form.collection_select :event_id, @events, :id, :name, { prompt: "Select an event", selected: @events.first&.id }, { required: true, class: "border rounded-sm px-3 py-2" } %>
      <%= form.submit "Reset", class: "border border-red-500 text-red-600 rounded-sm px-4 py-2 cursor-pointer" %>
    <% end %>
    <% if flash[:success] %>
      <p role="status" class="mt-4 text-green-700"><%= flash[:success] %></p>
    <% end %>
  </div>
<% end %>
