<h2 class="font-bold text-xl mb-2">Sponsor QR Codes</h2>
<p class="mb-8"><%= @event.name %></p>

<%= form_with url: admin_sponsor_qr_codes_path, method: :get, class: "flex gap-3 items-center mb-4" do |f| %>
  <%= f.label :event_id, "Event", class: "font-bold" %>
  <%= f.collection_select :event_id, @events, :id, :name, {selected: @event.id}, class: "border rounded-sm px-3 py-2" %>
  <%= f.submit "Show", class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
<% end %>

<dl class="flex gap-8 mb-8">
  <div>
    <dt class="font-bold">Total stamps (all events)</dt>
    <dd class="text-2xl" data-stamp-count="all"><%= number_with_delimiter(@total_stamp_count) %></dd>
  </div>
  <div>
    <dt class="font-bold">Total stamps (selected event)</dt>
    <dd class="text-2xl" data-stamp-count="event"><%= number_with_delimiter(@event_stamp_count) %></dd>
  </div>
</dl>

<% card_available = @template.persisted? %>
<section class="mb-8">
  <h3 class="font-bold text-lg mb-2">Booth QR card template</h3>
  <% if card_available %>
    <div class="flex gap-4 items-start mb-4">
      <%= image_tag @template.image.representation(resize_to_limit: [300, 300]), alt: "Booth QR card template", class: "border" %>
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
        <dt class="font-bold">File</dt>
        <dd><%= @template.image.filename %></dd>
        <dt class="font-bold">Size</dt>
        <dd><%= number_to_human_size(@template.image.byte_size) %></dd>
        <dt class="font-bold">Uploaded at</dt>
        <dd><%= @template.image.blob.created_at.in_time_zone("Asia/Tokyo").strftime("%Y-%m-%d %H:%M") %></dd>
      </dl>
    </div>
  <% else %>
    <p class="mb-4">No template uploaded yet.</p>
  <% end %>
  <%= form_with model: @template, url: admin_sponsor_booth_qr_card_template_path(event_id: @event.id), method: :patch, multipart: true do |f| %>
    <%= f.file_field :image, accept: SponsorBoothQrCardTemplate::ALLOWED_CONTENT_TYPES.join(","), required: true, class: "block mb-2 cursor-pointer file:border file:shadow-sm file:border-gray-500 file:rounded-sm file:bg-white file:px-4 file:py-2 file:mr-3 file:cursor-pointer hover:file:bg-gray-100" %>
    <%= f.submit "Upload template", class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
  <% end %>
  <p class="text-sm text-gray-600 mt-1">png / jpeg / webp, A5 portrait (148:210)</p>
</section>

<div
  data-controller="sponsor-qr-codes"
  data-sponsor-qr-codes-sponsors-value="<%= sponsor_qr_downloads(@qr_sponsors).to_json %>"
  data-sponsor-qr-codes-zip-filename-value="sponsor-qr-codes-<%= @event.slug %>.zip"
  data-sponsor-qr-codes-cards-value="<%= sponsor_booth_qr_card_downloads(@qr_sponsors, event_id: @event.id).to_json %>"
  data-sponsor-qr-codes-card-zip-filename-value="sponsor-booth-qr-cards-<%= @event.slug %>.zip"
>
  <p class="mb-4 text-red-700" role="alert" data-sponsor-qr-codes-target="error" hidden>Could not generate the QR codes. Please try again.</p>
  <p class="mb-4 text-red-700" role="alert" data-sponsor-qr-codes-target="cardError" hidden></p>
  <template data-sponsor-qr-codes-target="copySuccess">
    <%= render "admin/toast", type: :success, message: "URL copied." %>
  </template>
  <template data-sponsor-qr-codes-target="copyError">
    <%= render "admin/toast", type: :error, message: "Could not copy the URL. Please try again." %>
  </template>
  <p class="mb-4">Download a PNG for each sponsor and send the corresponding file to them.</p>
  <div class="flex gap-4 items-center mb-4">
    <button
      type="button"
      class="border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer disabled:cursor-wait disabled:opacity-50"
      data-action="sponsor-qr-codes#downloadAll"
      <% if @qr_sponsors.empty? %>disabled<% end %>
    >
      Download all as ZIP
    </button>
    <%= tag.button "Download all cards as ZIP",
      type: "button",
      class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50",
      disabled: !card_available || @qr_sponsors.empty?,
      data: {action: "sponsor-qr-codes#downloadAllCards"} %>
    <span data-sponsor-qr-codes-target="cardProgress" aria-live="polite"></span>
  </div>

  <div class="rounded-sm w-full pr-8 shadow-xs">
    <table class="w-full divide-y border">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-2 px-3 text-left">Sponsor</th>
          <th class="py-2 px-3 text-left">Plan</th>
          <th class="py-2 px-3 text-right">Stamp holders</th>
          <th class="py-2 px-3 text-left">Stamp URL</th>
          <th class="py-2 px-3 text-left">QR Code</th>
          <th class="py-2 px-3 text-left">QR Card</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% @sponsors.each do |sponsor| %>
          <tr>
            <td class="p-3"><%= sponsor[:name] %></td>
            <td class="p-3"><%= sponsor[:plan].capitalize %></td>
            <td class="p-3 text-right" data-stamp-count="sponsor"><%= number_with_delimiter(@sponsor_stamp_counts.fetch(sponsor[:key], 0)) %></td>
            <% if sponsor[:stamp_url] %>
            <td class="p-3">
              <button type="button" class="border rounded-sm px-4 py-2 cursor-pointer" data-url="<%= sponsor[:stamp_url] %>" data-action="sponsor-qr-codes#copyUrl">Copy URL</button>
            </td>
            <td class="p-3">
              <button type="button"
                class="border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer whitespace-nowrap disabled:cursor-wait disabled:opacity-50"
                data-url="<%= sponsor[:stamp_url] %>"
                data-filename="<%= sponsor_qr_filename(sponsor) %>"
                data-action="sponsor-qr-codes#download">
                Download PNG
              </button>
            </td>
            <td class="p-3">
              <div class="flex gap-3 items-center">
                <%= tag.button "Download card",
                  type: "button",
                  class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer whitespace-nowrap disabled:cursor-not-allowed disabled:opacity-50",
                  disabled: !card_available,
                  data: {
                    url: admin_sponsor_booth_qr_card_path(sponsor[:key], event_id: @event.id),
                    filename: sponsor_booth_qr_card_filename(sponsor),
                    action: "sponsor-qr-codes#downloadCard"
                  } %>
                <% if card_available %>
                  <%= link_to "Preview", admin_sponsor_booth_qr_card_path(sponsor[:key], event_id: @event.id, disposition: "inline"), target: "_blank", rel: "noopener", class: "underline" %>
                <% else %>
                  <span>—</span>
                <% end %>
              </div>
            </td>
            <% else %>
              <td class="p-3">—</td>
              <td class="p-3">—</td>
              <td class="p-3">—</td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
