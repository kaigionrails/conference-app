<%# locals: (social_announcement:, url:, method:) %>
<%= form_with model: social_announcement, url: url, method: method do |f| %>
  <%= f.hidden_field :event_id, value: social_announcement.event.id %>
  <p class="mb-4">Event: <%= social_announcement.event.name %></p>
  <%= f.label :campaign, "campaign (internal)", class: "block text-lg font-bold mb-2" %>
  <%= f.text_field :campaign, class: "block rounded-sm border-1 border-gray-400 mb-4 w-[40rem]" %>
  <%= f.label :note, "note (internal)", class: "block text-lg font-bold mb-2" %>
  <%= f.text_area :note, rows: 4, class: "block rounded-sm border-1 border-gray-400 mb-4 w-[40rem]" %>
  <%= f.submit class: "block border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
<% end %>
