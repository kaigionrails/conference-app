<%# locals: (announcement:, locale:, text:, errors: []) %>
<% persisted = text&.persisted? %>
<% posted = persisted && text.posts.any?(&:succeeded?) %>
<%= turbo_frame_tag "social_announcement_text_#{locale}" do %>
  <div class="border rounded-sm p-4">
    <h4 class="font-bold mb-2"><%= {"ja" => "日本語", "en" => "English"}[locale] %> (<%= locale %>)</h4>
    <% if errors.any? %>
      <p class="mb-2 text-sm text-red-700"><%= errors.join(", ") %></p>
    <% end %>
    <% if persisted %>
      <% review = text.latest_review %>
      <% if review %>
        <p class="mb-2"><span class="inline-block px-2 py-0.5 rounded-sm bg-green-100 border border-green-400">Reviewed (body &amp; media)</span> by <%= review.reviewed_by.name %> at <%= review.reviewed_at.in_time_zone("Tokyo") %></p>
      <% else %>
        <p class="mb-2"><span class="inline-block px-2 py-0.5 rounded-sm bg-yellow-100 border border-yellow-400">Not reviewed</span></p>
      <% end %>
    <% end %>
    <%= form_with url: (persisted ? admin_social_announcement_text_path(announcement, text) : admin_social_announcement_texts_path(announcement)), method: (persisted ? :patch : :post), scope: :social_announcement_text do |f| %>
      <%= f.hidden_field :locale, value: locale unless persisted %>
      <%= f.text_area :body, value: text&.body, rows: 8, readonly: posted, class: "block rounded-sm border-1 border-gray-400 mb-1 w-full #{"bg-gray-100" if posted}", data: {action: "input->admin--social-announcement#updateCount", "admin--social-announcement-target": "body"} %>
      <p class="text-sm text-gray-600 mb-2"><span data-admin--social-announcement-target="count"><%= Social::XWeightedLength.new(text&.body).to_i %></span> / <%= Social::XWeightedLength::LIMIT %> (X weighted)</p>
      <% hashtag_missing = text&.body.present? && !text.body.match?(SocialAnnouncement::RECOMMENDED_HASHTAG_PATTERN) %>
      <%= tag.p "⚠ #{SocialAnnouncement::RECOMMENDED_HASHTAG} is not included", class: "text-sm text-orange-700 mb-2", hidden: !hashtag_missing, data: {"admin--social-announcement-target": "hashtagWarning"} %>
      <% has_mention = text&.body.to_s.match?(SocialAnnouncement::MENTION_PATTERN) %>
      <%= tag.p "⚠ Mentions point to different accounts on each platform (this body goes to all of them as-is). On X, only the @user part of @user@domain becomes a mention.", class: "text-sm text-orange-700 mb-2", hidden: !has_mention, data: {"admin--social-announcement-target": "mentionWarning"} %>
      <% if posted %>
        <button type="button" disabled class="border rounded-sm px-4 py-2 text-gray-400 cursor-not-allowed">Save as draft</button>
        <span class="text-sm text-gray-600 ml-2">already posted</span>
      <% else %>
        <%= f.submit "Save as draft", class: "border shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer" %>
      <% end %>
    <% end %>
    <% if persisted %>
      <% unless text.approved? %>
        <%# レビューは Dispatch ボタンやフラッシュの表示にも影響するので frame を抜けて全画面遷移する %>
        <%= button_to "Approve current body and media", admin_social_announcement_text_reviews_path(announcement, social_announcement_text_id: text.id), method: :post, class: "mt-2 border shadow-sm border-green-600 rounded-sm px-4 py-2 cursor-pointer", form: {data: {turbo_frame: "_top"}} %>
      <% end %>
      <% if text.reviews.any? %>
        <details class="mt-2 text-sm">
          <summary class="cursor-pointer">Review history (<%= text.reviews.size %>)</summary>
          <ul class="list-disc ml-6">
            <% text.reviews.sort_by(&:reviewed_at).reverse.each do |r| %>
              <li><%= r.reviewed_at.in_time_zone("Tokyo") %> by <%= r.reviewed_by.name %> (body <%= r.body_digest.first(8) %>, media <%= r.media_digest.first(8) %>)<%= " — current" if r.body_digest == text.current_body_digest && r.media_digest == announcement.current_media_digest %></li>
            <% end %>
          </ul>
        </details>
      <% end %>
    <% end %>
  </div>
<% end %>
