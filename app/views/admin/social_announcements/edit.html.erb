<h2 class="font-bold text-xl mb-8">Edit social announcement 「<%= @social_announcement.campaign %>」 (id:<%= @social_announcement.id %>)</h2>
<%= render "admin/social_announcements/flash" %>
<div class="pr-8 mb-20">
  <%= render "admin/social_announcements/form", social_announcement: @social_announcement, url: admin_social_announcement_path(@social_announcement), method: :patch %>
  <%= link_to "back", admin_social_announcement_path(@social_announcement), class: "underline block mt-4" %>
</div>
