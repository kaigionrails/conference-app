<% content_for(:page_title, t("sponsor_stamp_cards.title")) %>

<div class="stamp-rally-page stamp-rally-result w-full max-w-xl mx-auto px-4 pt-3 pb-6 text-center">
  <section class="stamp-rally-cover stamp-rally-sheet" aria-labelledby="stamp-rally-title">
    <%= render "sponsor_stamp_cards/header", event: @event %>

    <% if @progress.completed? %>
      <h2 class="text-xl font-bold sm:text-2xl"><%= t(".complete_title") %></h2>
      <p class="mt-2 text-balance text-sm leading-relaxed stamp-rally-muted"><%= t(".complete_message") %></p>
    <% elsif !@newly_visited %>
      <p class="text-sm stamp-rally-muted"><%= t(".already_visited") %></p>
    <% end %>

    <div class="mt-3">
      <%= tag.div(
            class: class_names("stamp-rally-stamp-stage", {"stamp-rally-stamp-stage--new" => @newly_visited}),
            data: {new_stamp_celebration: @newly_visited || nil}
          ) do %>
        <% if @newly_visited %>
          <div class="stamp-rally-stamp-burst" aria-hidden="true"></div>
          <div class="stamp-rally-confetti" aria-hidden="true">
            <% 12.times do %>
              <span></span>
            <% end %>
          </div>
          <span class="stamp-rally-stamp-new-label" aria-hidden="true">NEW!</span>
        <% end %>

        <div class="stamp-rally-stamp" role="img" aria-label="<%= t(".stamp_number", number: @visit_number) %>">
          <span class="text-xs font-black tracking-widest" aria-hidden="true">VISITED</span>
          <span class="text-4xl font-black leading-none" aria-hidden="true">#<%= @visit_number.to_s.rjust(2, "0") %></span>
          <span class="text-xs font-bold" aria-hidden="true">KoR <%= @event.slug %></span>
        </div>
      <% end %>
    </div>

    <div>
      <p class="stamp-rally-sponsor-plan"><%= t(".plan", plan: @sponsor[:plan].capitalize) %></p>
      <p class="mt-1 break-words text-xl font-bold"><%= @sponsor[:name] %></p>
      <%= render "shared/sponsor_labels", sponsor: @sponsor %>
    </div>

    <section class="stamp-rally-next-goal text-left" aria-label="<%= t("sponsor_stamp_cards.show.progress") %>">
      <%= render "sponsor_stamp_cards/progress", stamp_card: @stamp_card, updated: @newly_visited %>
    </section>

    <% if @stamp_card.next_sponsors.any? %>
      <section class="stamp-rally-next-goal text-left" aria-labelledby="next-sponsors-title">
        <h2 id="next-sponsors-title" class="text-base font-bold"><%= t(".next_sponsors_title") %></h2>
        <ul class="mt-2 grid grid-cols-2 gap-2">
          <% @stamp_card.next_sponsors.each do |sponsor| %>
            <li class="stamp-rally-entry stamp-rally-suggestion" data-next-sponsor="<%= sponsor[:key] %>">
              <p class="stamp-rally-sponsor-plan"><%= t(".plan", plan: sponsor[:plan].capitalize) %></p>
              <p class="mt-1 break-words text-sm font-bold leading-snug"><%= sponsor[:name] %></p>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div class="stamp-rally-collection-action">
      <%= link_to t(".view_stamp_card"), sponsor_stamp_card_path(event_slug: @event.slug), class: "stamp-rally-collect-button inline-flex w-full items-center justify-center rounded-lg px-5 py-3 font-bold text-white" %>
      <%= link_to t(".back_to_profile"), profiles_path, class: "mt-2 inline-block py-2 text-sm underline underline-offset-4 stamp-rally-muted" %>
    </div>
  </section>
</div>
