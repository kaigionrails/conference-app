<div class="w-full">
  <div class="flex flex-col items-center">
    <div class="pt-5">
      <h1 class="font-bold text-4xl text-center mb-10"><%= t('sessions.new.title') %></h1>
      <div class="mb-10 flex justify-center">
        <%= render "shared/login_providers", variant: :card %>
      </div>
      <div class="mb-14">
        <details class="text-center w-72">
          <summary class="mb-4"><%= t('sessions.new.for_operators') %></summary>
          <%= form_with url: "/auth/email", method: :post, data: { turbo: false } do |f| %>
            <%= f.label :email, t('sessions.new.email'), class: "block font-bold mb-2 text-left" %>
            <%= f.email_field :email, class: "block rounded-sm mb-4 w-full" %>
            <%= f.label :password, t('sessions.new.password'), class: "block font-bold mb-2 text-left" %>
            <%= f.password_field :password, class: "block rounded-sm mb-4 w-full" %>
            <%= f.submit t('sessions.new.submit'), class: "block border bg-white shadow-sm border-gray-500 rounded-sm px-4 py-2 cursor-pointer mx-auto" %>
          <% end %>
        </details>
      </div>
    </div>
    <% if logged_in? %>
      <div class="text-center">
        <p class="mb-2"><%= t('sessions.new.you_are_logged_in') %></p>
        <%= button_to t('sessions.new.logout'), logout_path, method: :delete, form: { data: { turbo: false } }, class: "underline cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
