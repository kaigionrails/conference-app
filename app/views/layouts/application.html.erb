<!DOCTYPE html>
<html lang="<%= current_locale %>">
  <head>
    <title><%= page_title(yield(:page_title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "sponsor_passport", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <%= favicon_link_tag "icons/2026/favicon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "icons/2026/apple-touch-icon.png", rel: "apple-touch-icon", type: 'image/png' %>
    <script>
      window.vapidPublicKey = new Uint8Array(<%= vapid_public_key_bytes %>)
    </script>
  </head>

  <body class="theme-2026 bg-theme-background w-full pb-safe">
    <%= render partial: "layouts/header_nav" %>
    <% flash.each do |message_type, message| %>
      <div class="py-3 px-5 mb-4 relative z-10 <%= message_type_style(message_type) %>"><%# MEMO: relative and z-10 is for 2026's background image %>
        <%= message %>
      </div>
    <% end %>
    <main class="main-2026 mx-auto flex text-theme-primary relative z-10"><%# MEMO: relative and z-10 is for 2026's background image %>
      <%= yield %>
    </main>
    <div class="background-2026-items" aria-hidden="true">
      <div class="background-2026-item"></div>
    </div>
  </body>
</html>
