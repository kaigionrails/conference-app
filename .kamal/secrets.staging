# Secrets are fetched at deploy time from AWS Parameter Store (/conference-app-staging/*)
# in ap-northeast-1. Requires AWS credentials (OIDC role on GHA, `aws sso login`
# etc. locally). Each line is self-contained so it does not depend on kamal
# carrying intermediate variables between secret definitions.
#
# This file is tracked in git on purpose, even though `kamal init` gitignores
# `.kamal/secrets*`: it holds command substitutions, never the values themselves.
# Never write a literal secret in here.

KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region ap-northeast-1)

DATABASE_URL=$(aws ssm get-parameter --name /conference-app-staging/DATABASE_URL --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SECRET_KEY_BASE=$(aws ssm get-parameter --name /conference-app-staging/SECRET_KEY_BASE --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_APP_ID=$(aws ssm get-parameter --name /conference-app-staging/GITHUB_APP_ID --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_KEY=$(aws ssm get-parameter --name /conference-app-staging/GITHUB_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_SECRET=$(aws ssm get-parameter --name /conference-app-staging/GITHUB_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_PRIVATE_KEY=$(aws ssm get-parameter --name /conference-app-staging/GITHUB_PRIVATE_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SENTRY_DSN=$(aws ssm get-parameter --name /conference-app-staging/SENTRY_DSN --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SCOUT_KEY=$(aws ssm get-parameter --name /conference-app-staging/SCOUT_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFLARE_ACCESS_KEY_ID=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFLARE_ACCESS_KEY_ID --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFLARE_SECRET_ACCESS_KEY=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFLARE_SECRET_ACCESS_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFLARE_R2_ENDPOINT=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFLARE_R2_ENDPOINT --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFLARE_R2_BUCKET_NAME=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFLARE_R2_BUCKET_NAME --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFLARE_ACCOUNT_ID=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFLARE_ACCOUNT_ID --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFLARE_API_TOKEN=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFLARE_API_TOKEN --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
TITO_ACCOUNT_SLUG=$(aws ssm get-parameter --name /conference-app-staging/TITO_ACCOUNT_SLUG --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
TITO_API_TOKEN=$(aws ssm get-parameter --name /conference-app-staging/TITO_API_TOKEN --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
TITO_WEBHOOK_SECRET=$(aws ssm get-parameter --name /conference-app-staging/TITO_WEBHOOK_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
VAPID_PUBLIC_KEY=$(aws ssm get-parameter --name /conference-app-staging/VAPID_PUBLIC_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
VAPID_PRIVATE_KEY=$(aws ssm get-parameter --name /conference-app-staging/VAPID_PRIVATE_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFRONT_ORIGIN_SECRET=$(aws ssm get-parameter --name /conference-app-staging/CLOUDFRONT_ORIGIN_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)

# SNS 自動投稿 (X は Client ID/Secret のみ。user access/refresh は Admin の Connect X が DB に書く)
SOCIAL_X_CLIENT_ID=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_X_CLIENT_ID --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SOCIAL_X_CLIENT_SECRET=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_X_CLIENT_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SOCIAL_X_SCREEN_NAME=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_X_SCREEN_NAME --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(aws ssm get-parameter --name /conference-app-staging/ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(aws ssm get-parameter --name /conference-app-staging/ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(aws ssm get-parameter --name /conference-app-staging/ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SOCIAL_MASTODON_BASE_URL=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_MASTODON_BASE_URL --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SOCIAL_MASTODON_ACCESS_TOKEN=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_MASTODON_ACCESS_TOKEN --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SOCIAL_BLUESKY_HANDLE=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_BLUESKY_HANDLE --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SOCIAL_BLUESKY_APP_PASSWORD=$(aws ssm get-parameter --name /conference-app-staging/SOCIAL_BLUESKY_APP_PASSWORD --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
