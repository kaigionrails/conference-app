GITHUB_SECRET=$(aws ssm get-parameter --name /conference-app/GITHUB_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_PRIVATE_KEY=$(aws ssm get-parameter --name /conference-app/GITHUB_PRIVATE_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
